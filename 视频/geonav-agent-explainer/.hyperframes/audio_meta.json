{
  "bgm": null,
  "bgm_pending": false,
  "voices": [
    {
      "frame": 1,
      "path": "audio/voice-01.mp3",
      "duration_s": 18.837,
      "words": [
        {
          "id": 0,
          "text": "如果导航卫星信号不可用，一架只带相机的无人机，能在大范围未知区域里找到目标吗？",
          "start": 0.1,
          "end": 8.125
        },
        {
          "id": 1,
          "text": "这就是主动地理定位。",
          "start": 8.075,
          "end": 10.35
        },
        {
          "id": 2,
          "text": "智能体看不到全局地图，只能凭脚下的画面一步一步探索，直到走进目标所在的那一格。",
          "start": 10.35,
          "end": 18.387
        }
      ]
    },
    {
      "frame": 2,
      "path": "audio/voice-02.mp3",
      "duration_s": 27.562,
      "words": [
        {
          "id": 0,
          "text": "我们的平台把这个任务抽象成一个五乘五的网格世界。",
          "start": 0.1,
          "end": 5.125
        },
        {
          "id": 1,
          "text": "智能体每一步拿到两样东西：一张给定的目标图，和脚下的航拍图块。",
          "start": 5.075,
          "end": 11.5
        },
        {
          "id": 2,
          "text": "它可以选择上下左右移动，越界原地不动也要消耗一步，十步预算内走到目标格才算成功。",
          "start": 11.5,
          "end": 19.8
        },
        {
          "id": 3,
          "text": "目标坐标和真实距离是神谕信息，物理隔离在评测端，智能体永远看不到。",
          "start": 19.8,
          "end": 27.112
        }
      ]
    },
    {
      "frame": 3,
      "path": "audio/voice-03.mp3",
      "duration_s": 27.737,
      "words": [
        {
          "id": 0,
          "text": "评测的公平性靠工程保证：智能体只能读取公开状态，答案只在评测端解密。",
          "start": 0.1,
          "end": 7.8870000000000005
        },
        {
          "id": 1,
          "text": "主指标是成功率，按起始距离四到八格分层统计；辅助指标是终点距离。",
          "start": 7.837,
          "end": 15.162
        },
        {
          "id": 2,
          "text": "数据使用Masa航拍数据集，一百三十七张训练源图，验证与测试严格分开。",
          "start": 15.162,
          "end": 22.55
        },
        {
          "id": 3,
          "text": "全套平台有一百九十六项回归测试护住底线。",
          "start": 22.55,
          "end": 27.287
        }
      ]
    },
    {
      "frame": 4,
      "path": "audio/voice-04.mp3",
      "duration_s": 27.887,
      "words": [
        {
          "id": 0,
          "text": "第一阶段接入云端视觉语言模型。",
          "start": 0.1,
          "end": 3.6870000000000003
        },
        {
          "id": 1,
          "text": "每一步把目标图、当前画面，加上位置、预算和已访问格子发给模型，让它输出下一步动作。",
          "start": 3.637,
          "end": 12.437
        },
        {
          "id": 2,
          "text": "结果出乎意料：二十道验证题零成功。",
          "start": 12.437,
          "end": 16.512
        },
        {
          "id": 3,
          "text": "轨迹分析发现，模型在两个格子之间来回打转，十九道题出现ABAB循环。",
          "start": 16.512,
          "end": 24.087
        },
        {
          "id": 4,
          "text": "接口是通的，策略却是失败的。",
          "start": 24.087,
          "end": 27.437
        }
      ]
    },
    {
      "frame": 5,
      "path": "audio/voice-05.mp3",
      "duration_s": 26.887,
      "words": [
        {
          "id": 0,
          "text": "四臂对照实验给出了更完整的诊断。",
          "start": 0.1,
          "end": 3.6870000000000003
        },
        {
          "id": 1,
          "text": "单动作模型成功率百分之五，动作排序百分之十，加上防重复治理器仍是百分之十；而不看图的Frontier规则探索，成功率高达百分之五十。",
          "start": 3.637,
          "end": 16.937
        },
        {
          "id": 2,
          "text": "治理器把重复访问率降了一半，却换不来定位成功。",
          "start": 16.937,
          "end": 21.75
        },
        {
          "id": 3,
          "text": "云端路线按预登记协议暂停，问题转向本地。",
          "start": 21.75,
          "end": 26.437
        }
      ]
    },
    {
      "frame": 6,
      "path": "audio/voice-06.mp3",
      "duration_s": 26.687,
      "words": [
        {
          "id": 0,
          "text": "本地分支在八GB显存的笔记本上重新开始。",
          "start": 0.1,
          "end": 4.825
        },
        {
          "id": 1,
          "text": "冻结卫星图编码器，只训练一个八十万参数的小策略网络。",
          "start": 4.775,
          "end": 10.437
        },
        {
          "id": 2,
          "text": "修正到达奖励的错误之后，奖励塑形把成功率带到百分之四十四；再加入合法动作筛选，禁止越界和无效动作，三个种子全部提升，平均百分之六十六，越界率降到零。",
          "start": 10.437,
          "end": 26.237
        }
      ]
    },
    {
      "frame": 7,
      "path": "audio/voice-07.mp3",
      "duration_s": 24.1,
      "words": [
        {
          "id": 0,
          "text": "但百分之六十六的模型，真的看懂目标了吗？",
          "start": 0.1,
          "end": 3.975
        },
        {
          "id": 1,
          "text": "把目标图换成训练集均值，成功率几乎不掉。",
          "start": 3.925,
          "end": 8.475
        },
        {
          "id": 2,
          "text": "目标监督、源图留出诊断、五分类邻接头、解耦线索头，四轮实验全部没能建立可靠的目标证据。",
          "start": 8.475,
          "end": 17.912
        },
        {
          "id": 3,
          "text": "问题被精确定位成一句话：模型没有真正利用目标图的信息。",
          "start": 17.912,
          "end": 23.65
        }
      ]
    },
    {
      "frame": 8,
      "path": "audio/voice-08.mp3",
      "duration_s": 32.525,
      "words": [
        {
          "id": 0,
          "text": "突破来自一个很细的表征：边缘接缝。",
          "start": 0.1,
          "end": 3.862
        },
        {
          "id": 1,
          "text": "把当前图块与目标图块的四条边切成小段，逐段比较颜色误差、梯度误差和相关性，构成二十维特征。",
          "start": 3.8120000000000003,
          "end": 13.612
        },
        {
          "id": 2,
          "text": "只新增两千五百六十个参数，线索头第一次给出可信的邻接判断：目标是否就在相邻格、朝哪个方向。",
          "start": 13.612,
          "end": 23.275
        },
        {
          "id": 3,
          "text": "同样的开发集，成功率从百分之七十二点六跃升到百分之八十八点六，最难的短距离档提升最大。",
          "start": 23.275,
          "end": 32.075
        }
      ]
    },
    {
      "frame": 9,
      "path": "audio/voice-09.mp3",
      "duration_s": 23.625,
      "words": [
        {
          "id": 0,
          "text": "冻结全部权重与阈值，一百道验证题乘三个种子正式复验：成功率百分之八十九点三，终点距离零点三二，比基线高出十六点三个百分点，置信区间不包含零。",
          "start": 0.1,
          "end": 15.15
        },
        {
          "id": 1,
          "text": "十二项冻结检查全部通过，独立复核确认。",
          "start": 15.15,
          "end": 19.487
        },
        {
          "id": 2,
          "text": "默认配置正式切换到边缘线索方案。",
          "start": 19.487,
          "end": 23.175
        }
      ]
    },
    {
      "frame": 10,
      "path": "audio/voice-10.mp3",
      "duration_s": 21.262,
      "words": [
        {
          "id": 0,
          "text": "项目至今沉淀了完整的实验台账：每个批次可重放审计，失败与负结果全部保留。",
          "start": 0.1,
          "end": 7.875
        },
        {
          "id": 1,
          "text": "下一步是独立源图确认、测试集终评与跨数据集验证。",
          "start": 7.825,
          "end": 13.587
        },
        {
          "id": 2,
          "text": "主动探索的定位方法，正在从平台走向方法，再走向证据。",
          "start": 13.587,
          "end": 19.325
        },
        {
          "id": 3,
          "text": "谢谢观看。",
          "start": 19.325,
          "end": 20.812
        }
      ]
    }
  ],
  "sfx": []
}