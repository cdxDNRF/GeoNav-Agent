param([string]$PythonExe='', [int]$Port=8769, [switch]$NoBrowser)
$ErrorActionPreference='Stop'
$taskRoot=(Resolve-Path -LiteralPath (Join-Path $PSScriptRoot '..')).Path
if (-not $PythonExe) {
    if ($env:GEONAV_PYTHON) { $PythonExe=$env:GEONAV_PYTHON }
    elseif (Test-Path -LiteralPath 'D:\PYTHON\python.exe') { $PythonExe='D:\PYTHON\python.exe' }
    else { $taskPython=Get-Command python -ErrorAction SilentlyContinue; if ($taskPython) { $PythonExe=$taskPython.Source } }
}
if (-not $PythonExe -or -not (Test-Path -LiteralPath $PythonExe -PathType Leaf)) { throw '未找到Python。请通过 -PythonExe 指定已安装Python；搬迁包不含运行时。' }
$taskUrl="http://127.0.0.1:$Port"
try { $taskMeta=Invoke-RestMethod -Uri "$taskUrl/api/meta" -TimeoutSec 2; if ($taskMeta.version -eq 'geonav-workbench-v4.11') { if (-not $NoBrowser) { Start-Process $taskUrl }; return }; throw '端口已有其它版本或服务，已保留原服务；请结束旧服务或通过 -Port 选择新端口。' }
catch { if ($_.Exception.Message -like '*端口已有*') { throw } }
Push-Location -LiteralPath $taskRoot
try {
    # Keep native Python arguments free of nested quotes (Windows PowerShell 5.1).
    & $PythonExe -B -c 'import numpy, PIL, torch'
    if ($LASTEXITCODE -ne 0) { throw '依赖不齐；请查看搬迁包 requirements-workbench.txt。启动器不会自动安装或下载。' }
    Write-Host 'Python与本地导航依赖检查通过'
    $taskLog=Join-Path $taskRoot 'DATA/processed_data/平台实验/工作台_v1'
    New-Item -ItemType Directory -Path $taskLog -Force | Out-Null
    $taskStamp=Get-Date -Format 'yyyyMMdd-HHmmss'
    $taskProcess=Start-Process -FilePath $PythonExe -ArgumentList @('-B','-m','project.src.webapp.workbench_server_v18','--port',"$Port") -WorkingDirectory $taskRoot -RedirectStandardOutput (Join-Path $taskLog "server-$taskStamp.log") -RedirectStandardError (Join-Path $taskLog "server-$taskStamp.error.log") -WindowStyle Hidden -PassThru
    for ($taskTry=0; $taskTry -lt 40; $taskTry++) {
        if ($taskProcess.HasExited) { throw '工作台启动失败，请检查工作台目录中的error.log。' }
        try { $taskMeta=Invoke-RestMethod -Uri "$taskUrl/api/meta" -TimeoutSec 2; if ($taskMeta.version -eq 'geonav-workbench-v4.11') { if (-not $NoBrowser) { Start-Process $taskUrl }; Write-Host "GeoNav工作台已启动：$taskUrl · PID $($taskProcess.Id)"; return } } catch { }
        Start-Sleep -Milliseconds 500
    }
    throw '服务仍在初始化，请检查日志；不要盲目启动第二份。'
} finally { Pop-Location }
