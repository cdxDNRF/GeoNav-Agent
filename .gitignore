/DATA/processed_data/**/方向视图/**/*.jpeg
/DATA/processed_data/**/方向视图/**/*.png
/DATA/processed_data/**/targets/**/*.jpg
/DATA/processed_data/**/targets/**/*.jpeg
/DATA/processed_data/**/targets/**/*.png

