# Local API credentials (keep example templates versioned).
.env
.env.*
!.env.example
!.env.*.example

# Local tooling, dependencies, and caches.
.zcode/
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.superpowers/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
~$*

# Downloaded datasets, model weights, and the upstream reference checkout.
/DATA/raw_data/
/DATA/processed_data/**/patches/
/models/
/GOMAA-Geo/
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.safetensors

# Developer-machine helpers and one-off handoff prompts are not project deliverables.
/.agents/本地/
/project/src/tools/local/
/DATA/processed_data/**/源码快照/**/pi_*
/DATA/processed_data/**/源码快照/**/external_agent_smoke_*

# Full native rasters and step/prediction payloads stay at their local paths.
# Reports, frozen tasks, summaries, seals and hashes remain versioned.
/DATA/processed_data/**/*.tif
/DATA/processed_data/**/*.tiff
/DATA/processed_data/**/*.jsonl
!/DATA/processed_data/Masa/episodes/episodes_*.jsonl
!/DATA/processed_data/Masa/任务清单_v2/episodes_*.jsonl
!/DATA/processed_data/Masa/评测结果/Gemma与DeepSeek同策略对照_v1/原val任务清单.jsonl
