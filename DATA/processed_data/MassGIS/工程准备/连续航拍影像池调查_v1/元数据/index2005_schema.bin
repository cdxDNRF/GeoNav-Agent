<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:massgis="http://massgis.state.ma.us/featuretype" xmlns:wfs="http://www.opengis.net/wfs/2.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="http://massgis.state.ma.us/featuretype">
  <xsd:import namespace="http://www.opengis.net/gml/3.2" schemaLocation="https://gis-prod.digital.mass.gov/geoserver/schemas/gml/3.2.1/gml.xsd"/>
  <xsd:complexType name="GISDATA.DOWNLOADLINKS_2005Type">
    <xsd:complexContent>
      <xsd:extension base="gml:AbstractFeatureType">
        <xsd:sequence>
          <xsd:element maxOccurs="1" minOccurs="0" name="sheet_id" nillable="true" type="xsd:int"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="objectid" nillable="true" type="xsd:int"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="url_cs" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="url_lossy" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="gdb_geomattr_data" nillable="true" type="xsd:hexBinary"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="shape" nillable="true" type="gml:GeometryPropertyType"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:element name="GISDATA.DOWNLOADLINKS_2005" substitutionGroup="gml:AbstractFeature" type="massgis:GISDATA.DOWNLOADLINKS_2005Type"/>
</xsd:schema>
